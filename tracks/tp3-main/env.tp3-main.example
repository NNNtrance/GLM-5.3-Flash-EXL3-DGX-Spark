# ---------------------------------------------------------------------------
# env.tp3-main -- GLM-5.3-Flash full-scope EXL3 (4.05 bpw), TP=3 + expert parallel,
# DFlash2 draft, vision on. This is the NEW stack: vLLM 21d93d0d8 + cuda-exl3 448f1d6
# + 14 patches (tracks/tp3-main/README.md). It is not a drop-in edit of the old
# tracks/tp3 templates: the variable names differ, because this launcher is a new file.
#
# ONE COPY PER NODE, derived on that node with sed, never copied between nodes. A copied
# file gives a cluster where two processes believe they are the same rank, with no error
# at all (envs/README.md). Four lines differ per node: NODE_RANK, NODE_NAME, HOST_IP and
# INSTALL_DIR (through @HOME@).
#
# Placeholders to replace:
#   @NODE_RANK@   0 on head, 1 on worker-1, 2 on worker-2
#   @NODE_NAME@   head, worker-1 or worker-2 (the preflight cross-checks it against the rank)
#   @HOST_IP@     this node's own management address (192.0.2.10 / .11 / .12 in the examples)
#   @HEAD_IP@     the head node's management address (the same on all three)
#   @IFACE@       the management network interface name (NOT a fabric interface)
#   @HOME@        this node's home directory
#   @IMAGE_ID@    the image Id that build.sh printed (the same on all three nodes)
#
# Read by bin/start-tp3-main.sh (ExecStart) and bin/preflight-tp3-main.sh (ExecStartPre)
# with `set -a; . file; set +a`, so every line must be a plain KEY=VALUE assignment.
# ---------------------------------------------------------------------------

NODE_RANK=@NODE_RANK@
NODE_NAME=@NODE_NAME@
HOST_IP=@HOST_IP@
INSTALL_DIR=@HOME@/exl3-main

# --- Rendezvous and fabric ----------------------------------------------------
# MASTER_ADDR is rank 0's MANAGEMENT address, never a fabric one: a fabric address hangs
# the rendezvous silently (README quick-start step 8). Any free TCP port works.
MASTER_ADDR=@HEAD_IP@
MASTER_PORT=29531
GLOO_IFACE=@IFACE@
# The cores the engine is pinned to (--cpuset-cpus): the production value on GB10.
CPUSET=5-9,15-19

# The patched NCCL mesh plugin directory (patches/kernel/ of this repository, built per
# docs/06), mounted read-only at /opt/nccl-mesh. MESH_SO_SHA is the first 16 hex digits of
# the sha256 of libnccl-net-mesh.so in that directory; the preflight compares it on every
# boot. Builds of the same source can differ in this toolchain (docs/14 section 7.10), so
# take the value from YOUR build, the same one on all three nodes. Empty = not checked.
MESH_DIR=@HOME@/exl3-main/nccl-mesh-patched2
MESH_SO_SHA=
# NCCL_MESH_TIMEOUT_SEC. The plugin's own default is 30 s, and with that default a ~49 s
# JIT compile difference between ranks hangs the boot silently (the preflight's JIT gate
# below exists for the same reason). 180 is what production runs.
MESH_TIMEOUT=180

# --- What clients see ---------------------------------------------------------
PORT=8001
SERVED_MODEL_NAME=glm-5.3-flash

# --- Image (the tag enters the fast-load identity: never re-tag, use it as built) ---
IMG=harem/vllm-exl3-tasima:a4i-21d93d0d8-448f1d6
IMG_ID=@IMAGE_ID@

# --- Weights ------------------------------------------------------------------
# CKPT_DIR       turboderp/GLM-5.3-Flash-exl3 @ 2a30229e67012798ba9f0cd832bb78abf4c363d5 (branch 4.05bpw)
# TARGET_SIDECAR tools/sidecar_kur.py hedef  ... --cikti <this>   (symlinks + about 2.5 GB of split tensors)
# DRAFT_DIR      incoai/GLM-5.3-Flash-DFlash2 @ dc77ff1c99eeb2df044ee3d4f0094eb033fee410
# DRAFT_SIDECAR  tools/sidecar_kur.py taslak ... --cikti <this> --tp 3
# Every one of the four is mounted at its OWN host path (the sidecars are relative
# symlink trees; mount one anywhere else and the links dangle).
CKPT_DIR=/var/tmp/glm-5.3-flash-turboderp-4.05bpw
TARGET_SIDECAR=/var/tmp/glm-5.3-flash-turboderp-4.05bpw-harem
DRAFT_DIR=/var/tmp/dflash2-draft
DRAFT_SIDECAR=/var/tmp/dflash2-draft-tp3-harem

# The per-rank fast-load sidecar is FASTLOAD_DIR-r<rank>, about 53 GB per node.
#   FASTLOAD_MODE=dump  first boot of a new image / patch set / checkpoint: load the
#                       normal way, then write the sidecar (refuses to overwrite one)
#   FASTLOAD_MODE=load  every later boot: restore from the sidecar (production)
FASTLOAD_DIR=/var/tmp/exl3-main/fastload/glm53-main
FASTLOAD_MODE=load

# zai-org/GLM-5.3-Flash @ 690b7052 (4 September 2026), 10,950 bytes. Verify with
# scripts/verify-chat-template.py (docs/14 section 9.11).
CHAT_TEMPLATE=@HOME@/exl3-main/chat_template.jinja
CHAT_TEMPLATE_SHA=0c4099f3382d6c92

# JIT and tuner caches. Keep them apart from any other engine's. Mounted at /cache.
CACHE_DIR=/var/tmp/exl3-main/cache

# --- Memory and capacity ------------------------------------------------------
# 0.84 is the value this stack runs: KV pool about 6.19 M tokens at --max-model-len
# 1,000,000. It is a starting point you can move, not a limit: raise it in 0.01 steps
# and compare two values the way docs/09 prescribes. The headroom below it is unified
# memory shared with the OS: keep at least 1 GiB free in the worst case (16 large images
# plus a full set of running requests is the worst case we measured).
GMU=0.84
MAX_NUM_SEQS=5
MNBT=2048
# After drop_caches, wait until MemAvailable is at least this many GiB (checked, not assumed).
SETTLE_MIN_GIB=112

# --- Speculative decoding: the two config-only switches (README, "Two switches") ---
# Merged into --speculative-config (method dflash, k=7, fp8 draft KV cache) by
# tools/spec_extra.py:
#   disable_eagle_block_drop             keep the aligned block the EAGLE-style prefix hit
#                                        would drop (upstream vLLM #53388)
#   num_speculative_tokens_per_batch_size  [[1,1,7],[2,8,3]] = k=7 with one running request,
#                                        k=3 with two to eight
# Empty = plain k=7. The two keys are independent; each is a field of the JSON object.
# Keep the single quotes: this file is sourced by a shell, and unquoted JSON loses its quotes.
SPEC_EXTRA_JSON='{"disable_eagle_block_drop":true,"num_speculative_tokens_per_batch_size":[[1,1,7],[2,8,3]]}'

# --- Optional -----------------------------------------------------------------
# 1 = --enable-prompt-tokens-details (the prefix-cache hit becomes visible to clients).
PROMPT_DETAILS=1
# VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS.
EXEC_TIMEOUT_S=1800
# The preflight's JIT-cache gate (head only). 1 = refuse to boot unless the three nodes
# hold identical JIT cache listings (README, "The JIT cache gate"). 0 = skip it.
JIT_GATE=1
# Space-separated ssh names of the other two nodes, used only by that gate. Key-based ssh
# and passwordless `sudo find` are required on them.
JIT_PEERS="worker-1 worker-2"
# Informational only: if fewer free order-13 pages than this are left in /proc/buddyinfo the
# preflight prints a warning (fragmented memory cost 8-11 % of memory bandwidth after many
# engine restarts; a whole-cluster reboot restores it). It never blocks a boot.
FRAG_MIN_BLOCKS=2000
